# Environment Variables

# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── CONTACT FORM ────────────────────────────────────────────────────────────
# Set to your Formspree endpoint or custom API route for the contact form.
# Example Formspree: https://formspree.io/f/YOUR_FORM_ID
# Leave empty to use mailto: fallback.
VITE_CONTACT_ENDPOINT=

# ─── ANALYTICS ───────────────────────────────────────────────────────────────
# Set to enable analytics tracking. Integrate with Vercel Analytics or Plausible in src/lib/analytics.ts.
VITE_ANALYTICS_ID=

# ─── GEMINI AI (OPTIONAL FOR CHATBOT) ─────────────────────────────────────────
# Provide a Google Gemini API Key for dynamic real-time AI responses in ASK ARPIT.
# If omitted, the chatbot automatically uses the local instant knowledge engine.
VITE_GEMINI_API_KEY=

# ─── SITE URL ─────────────────────────────────────────────────────────────────
# Update when deployed to production domain.
VITE_SITE_URL=
